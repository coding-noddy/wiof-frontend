rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    match /Blogs/{id} {
      allow write: if request.auth.uid != null;
      allow read;
    }

    match /Subscriptions/{id} {
      allow write;
      allow read;
    }

    match /Polls/{id} {
      allow write;
      allow read;
    }

    match /Poll/{id} {
      allow write: if request.auth.uid != null;
      allow read;
    }

    match /News/{id} {
      allow write: if request.auth.uid != null;
      allow read;
    }

    match /Envcal/{id} {
      allow write: if request.auth.uid != null;
      allow read;
    }

    match /CoffeeConversations/{id} {
      allow write: if request.auth.uid != null;
      allow read;
    }

    match /InFocus/{id} {
      allow write: if request.auth.uid != null;
      allow read;
    }

    match /NGOinFocus/{id} {
      allow write: if request.auth.uid != null;
      allow read;
    }

    match /CourseInFocus/{id} {
      allow write: if request.auth.uid != null;
      allow read;
    }

    match /AboutUs/{id} {
      allow write: if request.auth.uid != null;
      allow read;
    }

    match /AboutUsProfiles/{id} {
      allow write: if request.auth.uid != null;
      allow read;
    }
  }
}
