rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Helper Functions ───────────────────────────────────────────────────

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Admin authority lives in the separate `admins` collection (doc ID == uid),
    // never in a field on the user's own profile document — a field a user can
    // write themselves can never be the thing that grants them privilege.
    // exists() here is a trusted rules-engine read and is not itself subject to
    // the `admins` collection's own read rule below, so this has no circular
    // dependency.
    function isAdmin() {
      return isAuthenticated()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Fields a signed-in user may change on their own profile document via the
    // Settings page (display name, avatar, preferred elements) — nothing else.
    // loginCount/lastLogin/daysVisited/currentStreak/longestStreak/
    // savedBlogsCount are system-managed engagement counters: a client that
    // could set them directly could forge its own login/streak history, so
    // they are written only by createUserProfile/recordLoginMetrics/
    // recordUserVisit/resetEngagementCounters (Cloud Functions, Admin SDK,
    // bypasses these rules) — never by this update path. role/uid/email/
    // joinedDate may never change at all.
    // Uses get(key, default) instead of direct field access because legacy
    // profile documents may not have every field (e.g. 'role'), and reading a
    // missing map key directly throws and denies the whole request.
    function isValidOwnProfileUpdate() {
      let allowedKeys = ['displayName', 'firstName', 'lastName', 'photoURL', 'preferredElements'];
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(allowedKeys)
        && request.resource.data.get('role', null) == resource.data.get('role', null)
        && request.resource.data.get('uid', null) == resource.data.get('uid', null)
        && request.resource.data.get('email', null) == resource.data.get('email', null)
        && request.resource.data.get('joinedDate', null) == resource.data.get('joinedDate', null);
    }

    // ─── User Profiles ──────────────────────────────────────────────────────

    match /users/{userId} {
      // Users can read their own profile; admins can read profiles for administration.
      allow read: if isOwner(userId) || isAdmin();

      // Profile documents are created only by the createUserProfile Cloud
      // Function (from verified ID token claims, not client-supplied data) —
      // no client create path exists at all, closing off both role
      // self-escalation and forged initial counter values in one rule.
      allow create: if false;
      allow update: if isOwner(userId) && isValidOwnProfileUpdate();
    }

    // ─── Admin Directory ────────────────────────────────────────────────────
    // Source of truth for admin authority (see isAdmin() above). Doc ID == uid.
    // No client write path exists by design: an admin is granted only via the
    // Firebase Console or a trusted server-side process, never by any request
    // this ruleset would accept. A signed-in user may only check their own
    // entry (no `list`), so the admin roster itself cannot be enumerated.
    match /admins/{uid} {
      allow get: if isOwner(uid);
      allow list: if false;
      allow write: if false;
    }

    // ─── User Saved Content ─────────────────────────────────────────────────

    match /user_saved_content/{docId} {
      // Read only own documents. `resource == null` handles a `get` on a
      // doc that doesn't exist yet (e.g. checking "is this saved?" or
      // "already saved?" before the first save) — resource is null for a
      // nonexistent document, and resource.data.userId on null throws,
      // which Firestore denies as permission-denied rather than returning
      // a clean "not found". Without this guard, the very first bookmark
      // of anything is unreachable. Safe: a nonexistent doc has no data to
      // protect, and an existing doc still only reads back true for its
      // actual owner.
      allow read: if isAuthenticated()
        && (resource == null || resource.data.userId == request.auth.uid);

      // Write only own documents with a server timestamp (prevents backdated writes)
      allow create: if isAuthenticated()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.savedAt == request.time;

      allow update: if isAuthenticated()
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.savedAt == request.time;

      // Same nonexistent-document guard as read: unsaveContent() deletes
      // unconditionally without checking existence first, so unsaving
      // something already unsaved (double-click, stale UI state) must not
      // throw either.
      allow delete: if isAuthenticated()
        && (resource == null || resource.data.userId == request.auth.uid);
    }

    // ─── Activity Log ───────────────────────────────────────────────────────

    match /activity_log/{docId} {
      // Users can read their own history; admins can read aggregate analytics.
      allow read: if isAdmin()
        || (isAuthenticated() && resource.data.userId == request.auth.uid);

      // Create only own documents with rate limiting (1 create/second)
      // Rate limit enforced by requiring timestamp == request.time (prevents backdated writes)
      allow create: if isAuthenticated()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.timestamp == request.time;

      // Fully immutable and append-only from the client: no update, no delete.
      // "Clear My Engagement Data" deletes these via the resetEngagementData
      // Cloud Function (Admin SDK, bypasses these rules) — the client never
      // needs a delete path of its own, so none exists.
      allow update: if false;
      allow delete: if false;
    }

    match /user_metrics/{uid} {
      // Materialized dashboard summary derived from activity_log (see
      // onActivityLogCreated / backfillUserMetrics in functions/index.js) —
      // owner can read their own; no client write path, Admin SDK only.
      // Also extended by onUserActionWritten with Take Action counters
      // (totalActionsCompleted, uniqueActionsCompleted, actionsByElement,
      // lastActionAt) — no new match block needed since write:false already
      // covers any new field names.
      allow read: if isOwner(uid) || isAdmin();
      allow write: if false;
    }

    // ─── Hero Videos ────────────────────────────────────────────────────────
    // One doc per fixed VideoWidgetComponent slot (HERO_VIDEO_SLOTS in
    // app.constants.ts). Public read; admin-only write, restricted to the
    // known slot ids and an 11-char YouTube video ID so a typo can't create
    // a stray slot or store a full URL the widget can't embed.

    match /hero_videos/{slotId} {
      allow read: if true;
      allow create, update: if isAdmin()
        && slotId in ['air', 'water', 'earth', 'energy', 'spirit', 'our-purpose']
        && request.resource.data.videoId is string
        && request.resource.data.videoId.matches('^[A-Za-z0-9_-]{11}$')
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0;
      allow delete: if isAdmin();
    }

    // Site-wide switches, one doc per setting. Public read (every visitor's
    // app checks them on load); admin-only write, limited to known doc ids.
    // launch_ceremony: { enabled: bool } — the launch-day curtain/ribbon.

    match /site_settings/{settingId} {
      allow read: if true;
      allow create, update: if isAdmin()
        && settingId in ['launch_ceremony']
        && request.resource.data.enabled is bool;
      allow delete: if isAdmin();
    }

    // ─── Take Action ────────────────────────────────────────────────────────

    match /actions/{actionId} {
      // Public read of the full catalogue, including deactivated items —
      // the client filters isActive==true for browsing, but a deactivated
      // action must stay readable so existing user_actions history
      // referencing it doesn't break (see Section 30 of the architecture doc).
      allow read: if true;
      allow write: if isAdmin();
    }

    // A calendar day string ('YYYY-MM-DD', the client's local date) that is
    // plausibly "today" somewhere on Earth right now. UTC offsets run from
    // -12h to +14h, so local-day midnight (read as UTC) always falls within
    // (now - 2d, now + 1d).
    function isPlausibleCalendarDay(day) {
      return day is string
        && day.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && timestamp.date(int(day.split('-')[0]), int(day.split('-')[1]), int(day.split('-')[2]))
             > request.time - duration.value(2, 'd')
        && timestamp.date(int(day.split('-')[0]), int(day.split('-')[1]), int(day.split('-')[2]))
             < request.time + duration.value(1, 'd');
    }

    function actionDoc(actionId) {
      return get(/databases/$(database)/documents/actions/$(actionId)).data;
    }

    // A DAILY completion must point at that day's user_action_completions
    // guard doc (already claimed by the client, one per day), and the day
    // must move strictly forward so one guard can't be replayed for many
    // increments.
    function isValidDailyCompletion(actionId, previousDay) {
      let day = request.resource.data.lastCompletionDay;
      return isPlausibleCalendarDay(day)
        && day > previousDay
        && exists(/databases/$(database)/documents/user_action_completions/$(request.auth.uid + '_' + actionId + '_' + day));
    }

    match /user_actions/{userActionId} {
      // Owner or admin can read. No `list` beyond a user's own docs: every
      // query the client issues already filters by userId, so this is
      // enforced the same way as activity_log's read rule.
      allow read: if isAdmin()
        || (isAuthenticated() && resource.data.userId == request.auth.uid);

      // onUserActionWritten derives user_metrics from completionCount and
      // elementIdsSnapshot, so neither may be client-chosen: a new doc starts
      // at exactly 0 (started) or 1 (completed), its element snapshot and
      // version must come from the live catalogue entry, and the doc ID is
      // pinned to {uid}_{actionId} so there is one doc per user per action.
      allow create: if isAuthenticated()
        && request.resource.data.userId == request.auth.uid
        && userActionId == request.auth.uid + '_' + request.resource.data.actionId
        && request.resource.data.keys().hasOnly([
             'userId', 'actionId', 'status', 'startedAt', 'completedAt', 'completionCount',
             'lastCompletedAt', 'lastCompletionDay', 'completionMethod', 'elementIdsSnapshot',
             'actionVersion', 'createdAt', 'updatedAt'])
        && actionDoc(request.resource.data.actionId).isActive == true
        && request.resource.data.elementIdsSnapshot is list
        && request.resource.data.elementIdsSnapshot.hasOnly(actionDoc(request.resource.data.actionId).elementIds)
        // <= rather than == so a page loaded just before an admin edit can
        // still complete the version the user actually saw.
        && request.resource.data.actionVersion is int
        && request.resource.data.actionVersion >= 1
        && request.resource.data.actionVersion <= actionDoc(request.resource.data.actionId).get('version', 1)
        && request.resource.data.completionMethod == 'SELF_REPORTED'
        && request.resource.data.startedAt == request.time
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && (
          (request.resource.data.status == 'IN_PROGRESS'
            && request.resource.data.completionCount == 0
            && request.resource.data.completedAt == null
            && request.resource.data.lastCompletedAt == null
            && request.resource.data.get('lastCompletionDay', null) == null)
          || (request.resource.data.status == 'COMPLETE'
            && request.resource.data.completionCount == 1
            && request.resource.data.completedAt == request.time
            && request.resource.data.lastCompletedAt == request.time
            && ((actionDoc(request.resource.data.actionId).repeatType == 'DAILY'
                  && isValidDailyCompletion(request.resource.data.actionId, ''))
                || (actionDoc(request.resource.data.actionId).repeatType != 'DAILY'
                  && request.resource.data.get('lastCompletionDay', null) == null)))
        );

      // Every client update is exactly one completion: status ends COMPLETE,
      // completionCount goes up by exactly 1 (never set, never lowered — the
      // Cloud Function counts positive deltas, so a lower-then-raise cycle
      // would otherwise inflate user_metrics), completion timestamps are
      // server-stamped, and the action's repeatType is respected: ONCE can
      // only complete once, DAILY once per guarded calendar day.
      // userId/actionId/elementIdsSnapshot/actionVersion/createdAt are
      // immutable after create (not in the affectedKeys allow-list).
      allow update: if isAuthenticated()
        && resource.data.userId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['status', 'completedAt', 'completionCount', 'lastCompletedAt', 'lastCompletionDay', 'updatedAt'])
        && request.resource.data.status == 'COMPLETE'
        && request.resource.data.completionCount == resource.data.get('completionCount', 0) + 1
        && request.resource.data.completedAt == request.time
        && request.resource.data.lastCompletedAt == request.time
        && request.resource.data.updatedAt == request.time
        && actionDoc(resource.data.actionId).isActive == true
        && (actionDoc(resource.data.actionId).repeatType != 'ONCE'
              || resource.data.get('completionCount', 0) == 0)
        && ((actionDoc(resource.data.actionId).repeatType == 'DAILY'
              && isValidDailyCompletion(resource.data.actionId, resource.data.get('lastCompletionDay', '')))
            || (actionDoc(resource.data.actionId).repeatType != 'DAILY'
              && request.resource.data.get('lastCompletionDay', null) == resource.data.get('lastCompletionDay', null)));

      allow delete: if false; // no client delete path needed in V1
    }

    // Per-calendar-day completion dedup guards for DAILY repeat actions, one
    // doc per userId+actionId+calendarDay. Deliberately a separate collection
    // from user_actions (rather than a second doc shape inside it) so this
    // can be fully immutable/append-only like activity_log — the same
    // deterministic-ID + denied-update trick UserActionService relies on to
    // treat a second same-day completion attempt as "already recorded."
    match /user_action_completions/{docId} {
      allow read: if isAdmin()
        || (isAuthenticated() && resource.data.userId == request.auth.uid);
      // The doc ID must be exactly {uid}_{actionId}_{calendarDay} (that's what
      // makes it a per-day dedup key), and the day must be plausibly today —
      // otherwise a client could pre-claim guards for future days and use
      // them to unlock extra DAILY completions in user_actions.
      allow create: if isAuthenticated()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.keys().hasOnly(['userId', 'actionId', 'calendarDay', 'createdAt'])
        && request.resource.data.actionId is string
        && isPlausibleCalendarDay(request.resource.data.calendarDay)
        && docId == request.auth.uid + '_' + request.resource.data.actionId + '_' + request.resource.data.calendarDay
        && request.resource.data.createdAt == request.time;
      allow update: if false;
      allow delete: if false;
    }

    // ─── Admin Collections ──────────────────────────────────────────────────
    // Read by all; write only by admin role users

    match /Blogs/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /News/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /CoffeeConversations/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /InFocus/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /NGOinFocus/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /CourseInFocus/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /Envcal/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /AboutUs/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /AboutUsProfiles/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ─── Public Collections ─────────────────────────────────────────────────
    // Public users can submit these forms, but cannot alter existing records.

    match /Subscriptions/{id} {
      // "Already subscribed?" checks go through the checkSubscriberExists
      // Cloud Function (Admin SDK, bypasses these rules) instead of a public
      // query — even a bounded (limit<=1) query lets a caller enumerate
      // individual known emails one at a time, so no public read path exists.
      allow get, list: if isAdmin();
      allow create: if request.resource.data.keys().hasOnly([
          'firstName', 'lastName', 'email', 'datetime'
        ])
        && request.resource.data.firstName is string
        && request.resource.data.firstName.size() <= 100
        && request.resource.data.lastName is string
        && request.resource.data.lastName.size() <= 100
        && request.resource.data.email is string
        && request.resource.data.email.size() <= 254
        && request.resource.data.datetime is string
        && request.resource.data.datetime.size() <= 40;
      allow update, delete: if isAdmin();
    }

    match /Feedback/{id} {
      // Site feedback form (footer, every public page). Anyone may submit;
      // only admins may read/triage. status must start as 'new' and
      // createdAt must be the server time, so a client cannot backdate a
      // submission or pre-mark it resolved. userId, when present, must be
      // the caller's own uid. Field limits mirror FEEDBACK_LIMITS in
      // src/app/models/Feedback.ts.
      // A signed-in user may read back only the feedback tagged with their
      // own uid (My Feedback page) — a list query must be constrained to
      // userId == their uid or it is denied.
      allow get, list: if isAdmin()
        || isAuthenticated() && resource.data.get('userId', null) == request.auth.uid;
      allow create: if request.resource.data.keys().hasOnly([
          'category', 'message', 'name', 'email', 'pageUrl', 'userAgent',
          'userId', 'status', 'createdAt'
        ])
        && request.resource.data.keys().hasAll(['category', 'message', 'status', 'createdAt'])
        && request.resource.data.category in ['issue', 'idea', 'content', 'other']
        && request.resource.data.message is string
        && request.resource.data.message.size() >= 10
        && request.resource.data.message.size() <= 2000
        && request.resource.data.status == 'new'
        && request.resource.data.createdAt == request.time
        && (!('name' in request.resource.data)
          || request.resource.data.name is string && request.resource.data.name.size() <= 100)
        && (!('email' in request.resource.data)
          || request.resource.data.email is string && request.resource.data.email.size() <= 254)
        && (!('pageUrl' in request.resource.data)
          || request.resource.data.pageUrl is string && request.resource.data.pageUrl.size() <= 500)
        && (!('userAgent' in request.resource.data)
          || request.resource.data.userAgent is string && request.resource.data.userAgent.size() <= 500)
        && (!('userId' in request.resource.data)
          || isAuthenticated() && request.resource.data.userId == request.auth.uid);
      allow update, delete: if isAdmin();
    }

    match /Polls/{id} {
      // Raw vote documents carry email/IP alongside the selected option, so
      // they are admin-only to read — never publicly listable or gettable.
      // Public results are served from the aggregate `poll_results` collection
      // below, kept in sync by a trusted Cloud Function.
      allow read: if isAdmin();
      allow create: if request.resource.data.keys().hasOnly([
          'pollQuestionId', 'option', 'ip4', 'ip6', 'email'
        ])
        && request.resource.data.pollQuestionId is string
        && request.resource.data.pollQuestionId.size() <= 200
        && request.resource.data.option is string
        && request.resource.data.option.size() <= 200
        && (!('email' in request.resource.data)
          || request.resource.data.email is string && request.resource.data.email.size() <= 254)
        && (!('ip4' in request.resource.data)
          || request.resource.data.ip4 is string && request.resource.data.ip4.size() <= 45)
        && (!('ip6' in request.resource.data)
          || request.resource.data.ip6 is string && request.resource.data.ip6.size() <= 45);
      allow update, delete: if isAdmin();
    }

    match /poll_results/{pollQuestionId} {
      // Sanitized aggregate (option -> vote counts, total) only — no email/IP.
      // Written only by the onPollVoteCreated Cloud Function via the Admin SDK,
      // which bypasses these rules, so the client write path is closed entirely.
      allow read: if true;
      allow write: if false;
    }

    match /Poll/{id} {
      allow read: if true;
      allow create: if isAdmin();
      allow update, delete: if isAdmin();
    }
  }
}
