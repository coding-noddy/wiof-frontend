rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Helper Functions ───────────────────────────────────────────────────

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // ─── User Profiles ──────────────────────────────────────────────────────

    match /users/{userId} {
      // Any authenticated user can read any profile
      allow read: if isAuthenticated();

      // Users can only create/update their own profile
      // Deny update of the 'role' field from client
      allow create: if isOwner(userId);
      allow update: if isOwner(userId)
        && (!('role' in request.resource.data) || request.resource.data.role == resource.data.role);
    }

    // ─── User Saved Content ─────────────────────────────────────────────────

    match /user_saved_content/{docId} {
      // Read only own documents
      allow read: if isAuthenticated()
        && resource.data.userId == request.auth.uid;

      // Write only own documents with rate limiting (1 write/second)
      // Rate limit enforced by requiring timestamp == request.time (prevents backdated writes)
      allow create: if isAuthenticated()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.timestamp == request.time;

      allow update: if isAuthenticated()
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.timestamp == request.time;

      allow delete: if isAuthenticated()
        && resource.data.userId == request.auth.uid;
    }

    // ─── Activity Log ───────────────────────────────────────────────────────

    match /activity_log/{docId} {
      // Read only own documents
      allow read: if isAuthenticated()
        && resource.data.userId == request.auth.uid;

      // Create only own documents with rate limiting (1 create/second)
      // Rate limit enforced by requiring timestamp == request.time (prevents backdated writes)
      allow create: if isAuthenticated()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.timestamp == request.time;

      // Deny all updates and deletes — activity log is append-only
      allow update: if false;
      allow delete: if false;
    }

    // ─── Admin Collections ──────────────────────────────────────────────────
    // Read by all; write only by admin role users

    match /Blogs/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /News/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /CoffeeConversations/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /InFocus/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /NGOinFocus/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /CourseInFocus/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /Envcal/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /AboutUs/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /AboutUsProfiles/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ─── Public Collections ─────────────────────────────────────────────────
    // Subscriptions and Polls remain publicly readable and writable

    match /Subscriptions/{id} {
      allow read, write: if true;
    }

    match /Polls/{id} {
      allow read, write: if true;
    }

    match /Poll/{id} {
      allow read, write: if true;
    }
  }
}
