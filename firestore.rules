rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Helper Functions ───────────────────────────────────────────────────

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // ─── User Profiles ──────────────────────────────────────────────────────

    match /users/{userId} {
      // Users can read their own profile; admins can read profiles for administration.
      allow read: if isOwner(userId) || isAdmin();

      // Users can only create/update their own profile
      // Deny update of the 'role' field from client
      allow create: if isOwner(userId);
      allow update: if isOwner(userId)
        && (!('role' in request.resource.data) || request.resource.data.role == resource.data.role);
    }

    // ─── User Saved Content ─────────────────────────────────────────────────

    match /user_saved_content/{docId} {
      // Read only own documents
      allow read: if isAuthenticated()
        && resource.data.userId == request.auth.uid;

      // Write only own documents with a server timestamp (prevents backdated writes)
      allow create: if isAuthenticated()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.savedAt == request.time;

      allow update: if isAuthenticated()
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.savedAt == request.time;

      allow delete: if isAuthenticated()
        && resource.data.userId == request.auth.uid;
    }

    // ─── Activity Log ───────────────────────────────────────────────────────

    match /activity_log/{docId} {
      // Users can read their own history; admins can read aggregate analytics.
      allow read: if isAdmin()
        || (isAuthenticated() && resource.data.userId == request.auth.uid);

      // Create only own documents with rate limiting (1 create/second)
      // Rate limit enforced by requiring timestamp == request.time (prevents backdated writes)
      allow create: if isAuthenticated()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.timestamp == request.time;

      // Activity logs are immutable, but owners may delete their own data reset records.
      allow update: if false;
      allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    // ─── Admin Collections ──────────────────────────────────────────────────
    // Read by all; write only by admin role users

    match /Blogs/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /News/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /CoffeeConversations/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /InFocus/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /NGOinFocus/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /CourseInFocus/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /Envcal/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /AboutUs/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /AboutUsProfiles/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ─── Public Collections ─────────────────────────────────────────────────
    // Public users can submit these forms, but cannot alter existing records.

    match /Subscriptions/{id} {
      // Anyone can check "already subscribed?" via a bounded (limit<=1) email
      // lookup; only admins can list/dump the full subscriber collection.
      allow get: if isAdmin();
      allow list: if isAdmin() || request.query.limit <= 1;
      allow create: if request.resource.data.keys().hasOnly([
          'firstName', 'lastName', 'email', 'datetime'
        ])
        && request.resource.data.firstName is string
        && request.resource.data.firstName.size() <= 100
        && request.resource.data.lastName is string
        && request.resource.data.lastName.size() <= 100
        && request.resource.data.email is string
        && request.resource.data.email.size() <= 254
        && request.resource.data.datetime is string
        && request.resource.data.datetime.size() <= 40;
      allow update, delete: if isAdmin();
    }

    match /Polls/{id} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly([
          'pollQuestionId', 'option', 'ip4', 'ip6', 'email'
        ])
        && request.resource.data.pollQuestionId is string
        && request.resource.data.pollQuestionId.size() <= 200
        && request.resource.data.option is string
        && request.resource.data.option.size() <= 200
        && (!('email' in request.resource.data)
          || request.resource.data.email is string && request.resource.data.email.size() <= 254)
        && (!('ip4' in request.resource.data)
          || request.resource.data.ip4 is string && request.resource.data.ip4.size() <= 45)
        && (!('ip6' in request.resource.data)
          || request.resource.data.ip6 is string && request.resource.data.ip6.size() <= 45);
      allow update, delete: if isAdmin();
    }

    match /Poll/{id} {
      allow read: if true;
      allow create: if isAdmin();
      allow update, delete: if isAdmin();
    }
  }
}
