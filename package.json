{
  "name": "wiof_frontend",
  "version": "6.4.1",
  "author": "Ionic Framework",
  "homepage": "https://ionicframework.com/",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "build:prod": "ng build --configuration production",
    "test": "ng test",
    "test:rules": "node scripts/run-rules-tests.js",
    "predeploy:staging": "npm run test:rules",
    "deploy:staging": "powershell -ExecutionPolicy Bypass -File ./deploy.ps1 -Target staging",
    "predeploy:prod": "npm run test:rules",
    "deploy:prod": "powershell -ExecutionPolicy Bypass -File ./deploy.ps1 -Target prod",
    "predeploy:staging:quick": "npm run test:rules",
    "deploy:staging:quick": "powershell -ExecutionPolicy Bypass -File ./deploy.ps1 -Target staging -SkipBranch",
    "predeploy:prod:quick": "npm run test:rules",
    "deploy:prod:quick": "powershell -ExecutionPolicy Bypass -File ./deploy.ps1 -Target prod -SkipBranch",
    "predeploy:rules": "npm run test:rules",
    "deploy:rules": "firebase deploy --only firestore:rules,storage",
    "predeploy:functions:staging": "npm run test:rules",
    "deploy:functions:staging": "firebase deploy --only functions --project wiof-staging",
    "predeploy:functions:prod": "npm run test:rules",
    "deploy:functions:prod": "firebase deploy --only functions --project wiof-production",
    "predeploy:backend:staging": "npm run test:rules",
    "deploy:backend:staging": "firebase deploy --only firestore:rules,firestore:indexes,storage,functions --project wiof-staging",
    "predeploy:backend:prod": "npm run test:rules",
    "deploy:backend:prod": "firebase deploy --only firestore:rules,firestore:indexes,storage,functions --project wiof-production",
    "verify:take-action": "node scripts/verify-take-action-catalogue.js"
  },
  "private": true,
  "description": "An Ionic project",
  "dependencies": {
    "@angular/animations": "~18.2.14",
    "@angular/cdk": "^18.2.14",
    "@angular/common": "~18.2.14",
    "@angular/core": "~18.2.14",
    "@angular/fire": "^18.0.1",
    "@angular/forms": "~18.2.14",
    "@angular/material": "^18.2.14",
    "@angular/platform-browser": "~18.2.14",
    "@angular/platform-browser-dynamic": "~18.2.14",
    "@angular/router": "~18.2.14",
    "@botom/quill-resize-module": "^2.2.2",
    "@ionic/angular": "^8.8.19",
    "chart.js": "^4.5.1",
    "file-saver": "^2.0.5",
    "firebase": "^10.14.1",
    "ng2-charts": "^5.0.4",
    "ngx-quill": "^26.0.10",
    "quill": "^2.0.3",
    "rxfire": "^6.0.0",
    "rxjs": "~7.8.0",
    "swiper": "^10.3.1",
    "tslib": "^2.6.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zone.js": "~0.14.10"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^18.2.21",
    "@angular/cli": "^18.2.21",
    "@angular/compiler": "~18.2.14",
    "@angular/compiler-cli": "~18.2.14",
    "@angular/language-service": "~18.2.14",
    "@firebase/rules-unit-testing": "^3.0.4",
    "@ionic/angular-toolkit": "^11.0.1",
    "@types/jasmine": "~4.6.0",
    "@types/node": "^20.0.0",
    "@types/papaparse": "^5.5.2",
    "jasmine-core": "~5.1.0",
    "jasmine-spec-reporter": "~7.0.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-coverage-istanbul-reporter": "^3.0.3",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "^2.1.0",
    "papaparse": "^5.5.4",
    "ts-node": "~10.9.0",
    "typescript": "~5.4.5"
  }
}
