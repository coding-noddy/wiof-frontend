{
  "name": "wiof_frontend",
  "version": "8.14.0",
  "author": "Ionic Framework",
  "homepage": "https://ionicframework.com/",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "build:prod": "ng build --configuration production",
    "test": "ng test",
    "test:rules": "node scripts/run-rules-tests.js",
    "test:functions": "node --test functions/activity-validation.test.js functions/user-metrics.test.js functions/blog-summary.test.js functions/related-content.test.js functions/daily-stats.test.js functions/social-meta.test.js functions/impact.test.js",
    "e2e:smoke": "node tests/e2e/public-smoke.e2e.js",
    "e2e:explore": "node tests/e2e/explore-next.e2e.js",
    "e2e:journey": "node tests/e2e/journey.e2e.js",
    "e2e:today": "node tests/e2e/today.e2e.js",
    "e2e:next": "node tests/e2e/next-for-you.e2e.js",
    "e2e:eq": "node tests/e2e/eq-limit.e2e.js",
    "e2e:analytics": "node tests/e2e/analytics.e2e.js",
    "predeploy:staging": "npm run test:functions && npm run test:rules",
    "deploy:staging": "powershell -ExecutionPolicy Bypass -File ./deploy.ps1 -Target staging",
    "predeploy:prod": "npm run test:functions && npm run test:rules",
    "deploy:prod": "powershell -ExecutionPolicy Bypass -File ./deploy.ps1 -Target prod",
    "predeploy:staging:quick": "npm run test:functions && npm run test:rules",
    "deploy:staging:quick": "powershell -ExecutionPolicy Bypass -File ./deploy.ps1 -Target staging -SkipBranch",
    "predeploy:prod:quick": "npm run test:functions && npm run test:rules",
    "deploy:prod:quick": "powershell -ExecutionPolicy Bypass -File ./deploy.ps1 -Target prod -SkipBranch",
    "predeploy:rules": "npm run test:functions && npm run test:rules",
    "deploy:rules": "firebase deploy --only firestore:rules,storage",
    "predeploy:functions:staging": "npm run test:functions && npm run test:rules",
    "deploy:functions:staging": "firebase deploy --only functions --project wiof-staging",
    "predeploy:functions:prod": "npm run test:functions && npm run test:rules",
    "deploy:functions:prod": "firebase deploy --only functions --project wiof-production",
    "predeploy:backend:staging": "npm run test:functions && npm run test:rules",
    "deploy:backend:staging": "firebase deploy --only firestore:rules,firestore:indexes,storage,functions --project wiof-staging",
    "predeploy:backend:prod": "npm run test:functions && npm run test:rules",
    "deploy:backend:prod": "firebase deploy --only firestore:rules,firestore:indexes,storage,functions --project wiof-production",
    "verify:take-action": "node scripts/verify-take-action-catalogue.js"
  },
  "private": true,
  "description": "An Ionic project",
  "dependencies": {
    "@angular/animations": "~21.2.26",
    "@angular/cdk": "^21.2.14",
    "@angular/common": "~21.2.26",
    "@angular/core": "~21.2.26",
    "@angular/fire": "^21.0.0",
    "@angular/forms": "~21.2.26",
    "@angular/material": "^21.2.14",
    "@angular/platform-browser": "~21.2.26",
    "@angular/platform-browser-dynamic": "~21.2.26",
    "@angular/router": "~21.2.26",
    "@botom/quill-resize-module": "^2.2.2",
    "@ionic/angular": "^8.8.19",
    "chart.js": "^4.5.1",
    "file-saver": "^2.0.5",
    "firebase": "^12.19.0",
    "ng2-charts": "^10.0.0",
    "ngx-quill": "^29.2.0",
    "quill": "^2.0.3",
    "rxfire": "^6.0.0",
    "rxjs": "~7.8.0",
    "swiper": "^12.2.0",
    "tslib": "^2.6.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zone.js": "~0.15.1"
  },
  "devDependencies": {
    "@angular/build": "^21.2.29",
    "@angular/cli": "^21.2.29",
    "@angular/compiler": "~21.2.26",
    "@angular/compiler-cli": "~21.2.26",
    "@angular/language-service": "~21.2.26",
    "@firebase/rules-unit-testing": "^5.0.2",
    "@ionic/angular-toolkit": "^13.0.0",
    "@types/jasmine": "~4.6.0",
    "@types/node": "^20.0.0",
    "@types/papaparse": "^5.5.2",
    "jasmine-core": "~5.1.0",
    "jasmine-spec-reporter": "~7.0.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-coverage-istanbul-reporter": "^3.0.3",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "^2.1.0",
    "papaparse": "^5.5.4",
    "ts-node": "~10.9.0",
    "typescript": "~5.9.3"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.14.7"
  }
}
